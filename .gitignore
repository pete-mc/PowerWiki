node_modules/
dist/
*.vsix

# Generated by tools/release/variant-manifest.mjs
vss-extension.dev.json
vss-extension.canary.json
npm-debug.log*
ado.pat
mcps
tools/pw/artifacts/
tools/serve/.cert/
screenshots/
# ...but the Marketplace screenshots are content, not artefacts. The rule above
# is unanchored, so it swallows media/screenshots too and a new store image gets
# silently dropped from a commit — which is exactly what happened to the work
# item screenshot in 1.4.0.
!media/screenshots/
.claude/settings.local.json

# Machine-specific agent notes; AGENTS.md is the tracked source of truth.
CLAUDE.local.md
AGENTS.local.md

# VS Code extension build output and downloaded test runtimes
vscode/dist/
vscode/*.vsix
.vscode-test/
tools/e2e/artifacts/
