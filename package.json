{
  "name": "powerwiki",
  "version": "0.2.24",
  "description": "PowerWiki is an Azure DevOps extension that adds a Power Wiki menu experience while continuing to use the standard Azure DevOps Wiki repositories as the source of truth.",
  "private": true,
  "main": "dist/powerwiki.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "package:vsix": "npm run build && npx tfx-cli extension create --manifest-globs vss-extension.json",
    "publish:marketplace": "npm run build && npx tfx-cli extension publish --manifest-globs vss-extension.json",
    "test": "npm run typecheck"
  },
  "keywords": [
    "azure-devops",
    "wiki",
    "markdown",
    "mermaid"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "azure-devops-extension-api": "^5.273.0",
    "azure-devops-extension-sdk": "^4.2.0",
    "dompurify": "^3.4.11",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "style-loader": "^4.0.0",
    "tfx-cli": "^0.23.2",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.108.3",
    "webpack-cli": "^7.1.0"
  }
}
