{
  "name": "powerwiki",
  "version": "1.3.5",
  "description": "PowerWiki is an Azure DevOps extension that adds a Power Wiki menu experience while continuing to use the standard Azure DevOps Wiki repositories as the source of truth.",
  "private": true,
  "main": "dist/powerwiki.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "package:vsix": "npm run build && npx tfx-cli extension create --manifest-globs vss-extension.json",
    "publish:marketplace": "npm run build && npx tfx-cli extension publish --manifest-globs vss-extension.json",
    "pw:auth": "node tools/pw/auth.mjs",
    "pw:verify": "node tools/pw/verify.mjs",
    "test:unit": "vitest run",
    "test": "npm run typecheck && vitest run"
  },
  "keywords": [
    "azure-devops",
    "wiki",
    "markdown",
    "mermaid"
  ],
  "author": "Peter McDonald <peter@mcdonald.xyz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pete-mc/PowerWiki.git"
  },
  "bugs": {
    "url": "https://github.com/pete-mc/PowerWiki/issues"
  },
  "homepage": "https://github.com/pete-mc/PowerWiki#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "azure-devops-extension-api": "^5.273.0",
    "azure-devops-extension-sdk": "^4.2.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.0",
    "mathml2omml": "^0.5.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "style-loader": "^4.0.0",
    "tfx-cli": "^0.23.2",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "webpack": "^5.108.3",
    "webpack-cli": "^7.1.0"
  }
}

