{
  "manifestVersion": 1,
  "id": "powerwiki",
  "version": "0.2.21",
  "name": "PowerWiki",
  "publisher": "dataversepowertools",
  "description": "An alternate Power Wiki experience for Azure DevOps Wikis with modern Markdown and Mermaid rendering.",
  "public": false,
  "categories": ["Azure Repos"],
  "icons": {
    "default": "media/logo_new.png"
  },
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "content": {
    "details": {
      "path": "overview.md"
    }
  },
  "contributions": [
    {
      "id": "powerwiki-hub-group",
      "type": "ms.vss-web.hub-group",
      "description": "Adds Power Wiki as a project-level menu item.",
      "targets": ["ms.vss-web.project-hub-groups-collection"],
      "properties": {
        "name": "Power Wiki",
        "order": 90,
        "icon": "media/logo_new.png"
      }
    },
    {
      "id": "powerwiki-hub",
      "type": "ms.vss-web.hub",
      "description": "Adds the alternate Power Wiki screen.",
      "targets": [".powerwiki-hub-group"],
      "properties": {
        "name": "Power Wiki",
        "order": 10,
        "uri": "dist/powerwiki.html",
        "icon": "media/logo_new.png"
      }
    },
    {
      "id": "powerwiki-overview-hub",
      "type": "ms.vss-web.hub",
      "description": "Adds the alternate Power Wiki screen under Overview.",
      "targets": ["ms.vss-tfs-web.project-overview-hub-group"],
      "properties": {
        "name": "Power Wiki",
        "order": 35,
        "uri": "dist/powerwiki.html",
        "icon": "media/logo_new.png"
      }
    }
  ],
  "scopes": ["vso.wiki_write"],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "overview.md",
      "addressable": false
    },
    {
      "path": "media/logo_new.png",
      "addressable": true
    }
  ]
}
