{
  "manifestVersion": 1,
  "id": "powerwiki",
  "version": "1.4.1",
  "name": "PowerWiki",
  "publisher": "dataversepowertools",
  "description": "An alternate Power Wiki experience for Azure DevOps Wikis with modern Markdown and Mermaid rendering.",
  "public": true,
  "categories": [
    "Azure Repos"
  ],
  "icons": {
    "default": "media/logo_new.png"
  },
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "links": {
    "getstarted": {
      "uri": "https://github.com/pete-mc/PowerWiki#readme"
    },
    "learn": {
      "uri": "https://github.com/pete-mc/PowerWiki"
    },
    "support": {
      "uri": "https://github.com/pete-mc/PowerWiki/issues"
    },
    "license": {
      "uri": "https://github.com/pete-mc/PowerWiki/blob/main/LICENSE"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/pete-mc/PowerWiki"
  },
  "contributions": [
    {
      "id": "group",
      "type": "ms.vss-web.hub-group",
      "description": "Adds Power Wiki as a project-level menu item.",
      "targets": [
        "ms.vss-web.project-hub-groups-collection"
      ],
      "properties": {
        "name": "Power Wiki",
        "order": 90,
        "icon": "media/logo_new.png"
      }
    },
    {
      "id": "wiki",
      "type": "ms.vss-web.hub",
      "description": "Adds the alternate Power Wiki screen.",
      "targets": [
        ".group"
      ],
      "properties": {
        "name": "Power Wiki",
        "order": 10,
        "uri": "dist/powerwiki.html",
        "icon": "media/logo_new.png"
      }
    },
    {
      "id": "overview",
      "type": "ms.vss-web.hub",
      "description": "Adds the alternate Power Wiki screen under Overview.",
      "targets": [
        "ms.vss-web.home-hub-group"
      ],
      "properties": {
        "name": "Power Wiki",
        "order": 75,
        "uri": "dist/powerwiki.html",
        "icon": "media/logo_new.png"
      }
    },
    {
      "id": "workItemWiki",
      "type": "ms.vss-work-web.work-item-form-page",
      "description": "Adds a Power Wiki tab to the work item form showing its linked wiki pages.",
      "targets": [
        "ms.vss-work-web.work-item-form"
      ],
      "properties": {
        "name": "Power Wiki",
        "uri": "dist/powerwiki-workitem.html",
        "order": 30
      }
    }
  ],
  "scopes": [
    "vso.wiki_write",
    "vso.work",
    "vso.code",
    "vso.notification_write"
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "media/logo_new.png",
      "addressable": true
    },
    {
      "path": "media/screenshots",
      "addressable": true
    }
  ]
}
